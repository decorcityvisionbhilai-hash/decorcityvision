# Copy this file to .env.local and fill in your Sanity project's values.
# Get projectId/dataset from https://www.sanity.io/manage after creating a
# project (or run `npx sanity init` from this directory to create one and
# have it fill these in for you).

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Required for live updates — without this, publishing in Studio still
# works, it just needs a page reload (or up to 60s) to show up instead of
# updating instantly. Create one at https://www.sanity.io/manage under
# API > Tokens (Viewer role is enough).
# SANITY_API_READ_TOKEN=

# Only needed to run `npm run sanity:seed-jobs`. Create one at
# https://www.sanity.io/manage under API > Tokens (Editor role — it writes).
# SANITY_API_WRITE_TOKEN=
